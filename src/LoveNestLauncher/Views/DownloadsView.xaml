<UserControl x:Class="LoveNestLauncher.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="650">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,26">

            <Grid>
                <StackPanel>
                    <TextBlock Text="下载中心" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{Binding AutoExtractHint}" Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding OpenDownloadFolderCommand}" Padding="9,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="打开下载目录" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,16,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="232" Height="34" Background="#66FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock Text="搜索版本" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchTextBoxStyle}" />
                    </Grid>
                </Border>

                <ListBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                         Style="{StaticResource FilterListBoxStyle}" VerticalAlignment="Center" Margin="10,0,8,0" />

                <TextBlock Grid.Column="2" Text="{Binding FilteredCountText}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="4,0,2,0" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,2,0,8"
                    Visibility="{Binding IsLoadingVersions, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="正在读取下载源…" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="30" Margin="0,2,0,8"
                    Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding NoResultsText}" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <Button Style="{StaticResource SoftButtonStyle}" Content="清除筛选" Margin="0,10,0,0"
                            Padding="11,6" FontSize="10.5" HorizontalAlignment="Center"
                            Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding VersionsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,8" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38" Height="38" CornerRadius="10" Background="{Binding FileTypeBackground}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileType}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="9.5" FontWeight="Bold" Foreground="{Binding FileTypeForeground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="2,0,14,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleText}"
                                                   MaxWidth="390" />
                                        <Border Background="{Binding TagBackground}" CornerRadius="5" Padding="6,1"
                                                Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{Binding TagForeground}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource CaptionText}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Url}" />

                                    <Grid Margin="0,5,0,0"
                                          Visibility="{Binding ShowStatusLine, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="5" Height="5" CornerRadius="3" Background="{Binding StatusBrush}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}" Margin="5,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusDetailText}" Style="{StaticResource CaptionText}"
                                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <ProgressBar Style="{StaticResource DownloadProgressStyle}" Margin="0,7,0,0"
                                                 Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}" />

                                    <ProgressBar Style="{StaticResource DownloadProgressStyle}" Margin="0,7,0,0"
                                                 Maximum="100" Value="{Binding ExtractProgress, Mode=OneWay}"
                                                 Visibility="{Binding IsExtractProgressVisible, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="102" Height="32"
                                            Padding="10,5" FontSize="10.5"
                                            AutomationProperties.Name="{Binding PrimaryActionText}"
                                            Command="{Binding DataContext.PrimaryActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanPrimaryAction}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PrimaryActionGlyph}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="10" Foreground="White" Margin="0,0,5,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PrimaryActionText}" Foreground="White"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Margin="3,0,0,0"
                                            Command="{Binding DataContext.OpenItemFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="打开所在文件夹"
                                            Visibility="{Binding IsOpenFolderVisible, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Margin="3,0,0,0"
                                            Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="取消下载"
                                            Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   Foreground="{StaticResource DangerBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="2,8,2,0">
                <TextBlock Text="{Binding SourceStatusText}" Style="{StaticResource CaptionText}" />
                <TextBlock Text="下载源由 青音连旭 提供" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
