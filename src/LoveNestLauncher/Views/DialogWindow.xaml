<Window x:Class="LoveNestLauncher.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Love Nest Launcher"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Opacity="0">
    <Grid Margin="18">
        <Border Background="White" CornerRadius="20" BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1" Padding="24,22,24,22">
            <Border.Effect>
                <DropShadowEffect Color="#512A3A" BlurRadius="34" ShadowDepth="10" Opacity="0.26" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBox" Width="36" Height="36" CornerRadius="11"
                            Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                        <TextBlock x:Name="IconGlyph" Text="&#xE946;" FontFamily="{StaticResource IconFont}"
                                   FontSize="17" Foreground="{StaticResource AccentDeepBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="提示" FontSize="18" FontWeight="Bold"
                               Margin="4,5,10,0" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                            Click="Close_Click" ToolTip="关闭">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="330" Margin="48,13,8,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12.5" LineHeight="23"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="86" Margin="0,0,9,0" Click="Secondary_Click" />
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="100" Click="Primary_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
