<UserControl x:Class="LoveNestLauncher.Views.MoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="650">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,26" MaxWidth="820">

            <TextBlock Text="其他" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="下载源、工具和帮助。" Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0" />

            <TextBlock Text="下载源" Style="{StaticResource SectionTitleText}" Margin="2,20,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SourceDisplayName}" FontSize="12.5" FontWeight="SemiBold" />
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="5,1" Margin="7,0,0,0">
                                <TextBlock Text="{Binding SourceBadgeText}" FontSize="8.5" Foreground="{StaticResource AccentDeepBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding VersionsCountText}" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" />
                    </Grid>
                    <TextBlock Text="{Binding SourcePathDisplay}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePathDisplay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="导入 TXT" Padding="12,6" FontSize="10.5"
                                Command="{Binding ImportSourceCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="恢复内置" Padding="10,6" FontSize="10.5"
                                Margin="5,0,0,0" IsEnabled="{Binding IsCustomSource}" Command="{Binding ResetSourceCommand}" />
                        <Button Style="{StaticResource GhostButtonStyle}" Content="查看文件" Padding="8,6" FontSize="10.5"
                                Margin="2,0,0,0" Command="{Binding OpenSourceFileCommand}" />
                    </StackPanel>
                    <TextBlock Text="TXT 每行：版本名称 + 至少两个空格 + 下载地址。" Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="工具" Style="{StaticResource SectionTitleText}" Margin="2,18,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="14">
                <WrapPanel>
                    <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,4" Command="{Binding OpenDownloadFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="下载目录" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,4" Command="{Binding OpenDataFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="数据目录" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,4" Command="{Binding OpenLogCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="运行日志" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,4" Command="{Binding ClearTempCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource DangerBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="清理临时文件" FontSize="10.5" Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

            <TextBlock Text="帮助" Style="{StaticResource SectionTitleText}" Margin="2,18,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="自动解压" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ExtractionSupportText}" FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9" />
                    <Grid>
                        <TextBlock Text="没有识别到游戏" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="在设置中手动选择游戏 EXE" FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9" />
                    <Grid>
                        <TextBlock Text="同时运行" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="只能启动一个爱之巢实例" FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="设置与日志只保存在本机。下载源由 青音连旭 提供。" Style="{StaticResource CaptionText}"
                       Margin="2,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
