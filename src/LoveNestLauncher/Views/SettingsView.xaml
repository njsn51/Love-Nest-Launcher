<UserControl x:Class="LoveNestLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="650">
    <UserControl.Resources>
        <Style x:Key="SettingLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="RowDivider" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="0,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,26">

            <TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="下载、游戏与外观。" Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0" />

            <TextBlock Text="下载" Style="{StaticResource SectionTitleText}" Margin="2,20,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,2,16,0">
                            <TextBlock Text="保存位置" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="下载文件会保存在这里。" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="下载保存位置"
                                     Style="{StaticResource InputTextBoxStyle}" Height="36" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="浏览"
                                    Padding="12,7" Margin="7,0,0,0" FontSize="10.5"
                                    Command="{Binding BrowseDownloadFolderCommand}" />
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="36" Height="36"
                                    Margin="4,0,0,0" Command="{Binding OpenDownloadFolderCommand}" ToolTip="打开下载目录">
                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                            </Button>
                        </Grid>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="下载完成后自动解压" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="压缩包会保留在下载目录。" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                  AutomationProperties.Name="下载完成后自动解压"
                                  IsChecked="{Binding AutoExtract, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,2,16,0">
                            <TextBlock Text="同时下载" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="建议保持 2 个。" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="1 个" GroupName="Concurrency" Style="{StaticResource SegmentRadioStyle}"
                                         IsChecked="{Binding IsOneDownload, Mode=TwoWay}" />
                            <RadioButton Content="2 个" GroupName="Concurrency" Style="{StaticResource SegmentRadioStyle}"
                                         IsChecked="{Binding IsTwoDownloads, Mode=TwoWay}" />
                            <RadioButton Content="3 个" GroupName="Concurrency" Style="{StaticResource SegmentRadioStyle}"
                                         IsChecked="{Binding IsThreeDownloads, Mode=TwoWay}" Margin="0" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="下载设置修改后需要保存" FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="5,1" Margin="6,0,0,0"
                                    Visibility="{Binding HasUnsavedSettings, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="未保存" FontSize="8.5" Foreground="{StaticResource AccentDeepBrush}" />
                            </Border>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Content="保存下载设置"
                                Padding="14,7" FontSize="10.5" Command="{Binding SaveSettingsCommand}"
                                IsEnabled="{Binding HasUnsavedSettings}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="游戏" Style="{StaticResource SectionTitleText}" Margin="2,18,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,2,16,0">
                            <TextBlock Text="游戏程序" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="用于从主页直接启动。" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Border Background="#A6FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8">
                                <TextBlock Text="{Binding GameExecutableDisplay}" FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding GameExecutableTooltip}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Style="{StaticResource SoftButtonStyle}" Content="选择程序" Padding="11,6"
                                        FontSize="10.5" Command="{Binding SelectGameExecutableCommand}" />
                                <Button Style="{StaticResource GhostButtonStyle}" Content="自动查找" Padding="9,6"
                                        FontSize="10.5" Margin="3,0,0,0" Command="{Binding AutoDetectGameCommand}" />
                                <TextBlock Text="一次只允许运行一个实例" FontSize="9.5"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="外观" Style="{StaticResource SectionTitleText}" Margin="2,18,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="亚克力透明背景" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="Windows 亚克力模糊效果，关闭后使用纯色背景。" Style="{StaticResource SettingHint}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                              AutomationProperties.Name="亚克力透明背景"
                              IsChecked="{Binding EnableAcrylic, Mode=TwoWay}" />
                </Grid>
            </Border>

            <TextBlock Text="游戏与外观设置会立即保存。" Style="{StaticResource CaptionText}" Margin="2,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
