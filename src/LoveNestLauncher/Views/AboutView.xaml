<UserControl x:Class="LoveNestLauncher.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="650">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,26" MaxWidth="820">

            <TextBlock Text="关于" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Love Nest Launcher 是一份送给爱之巢玩家的小礼物。" Style="{StaticResource PageSubtitleText}"
                       Margin="0,4,0,0" />

            <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" CornerRadius="13" Background="{StaticResource AccentSoftBrush}">
                        <Image Source="/Assets/app.png" Width="54" Height="54" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Love Nest Launcher" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="{Binding AppSlogan}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding AppVersion}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{StaticResource AccentDeepBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="Windows x64" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="作者" Style="{StaticResource SectionTitleText}" Margin="2,18,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Grid Margin="18,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Author}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="作者 / 开发" FontSize="10" Foreground="{StaticResource AccentDeepBrush}" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="18,0" />
                    <Grid Margin="18,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Designer}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="设计思路" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="18,0" />
                    <Grid Margin="18,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SourceProvider}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="下载源" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="说明" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="玩家自制工具，与游戏官方无关。游戏及相关内容的版权归原作者所有。" FontSize="10.5"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <TextBlock Text="下载源由 青音连旭 整理提供，感谢分享。" FontSize="10.5"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Copyright}" Style="{StaticResource CaptionText}" Margin="2,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
