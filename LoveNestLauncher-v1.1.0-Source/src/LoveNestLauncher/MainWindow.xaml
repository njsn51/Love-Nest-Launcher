<Window x:Class="LoveNestLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:LoveNestLauncher.Views"
        mc:Ignorable="d"
        Title="Love Nest Launcher"
        Icon="/Assets/app.ico"
        Width="1100"
        Height="700"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FBF8FA"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Background="#FBF8FA" CornerRadius="16"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,18,14,12" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                            <Image Source="/Assets/app.png" Width="30" Height="30" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Love Nest" FontSize="14.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}" Margin="10,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButtonStyle}"
                                        AutomationProperties.Name="{Binding Title}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Margin="20,0,16,16">
                        <TextBlock Text="{Binding AppVersion}" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="by 小茗白茶QWQ" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click"
                                AutomationProperties.Name="最小化" ToolTip="最小化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource WindowButtonStyle}" Click="MaximizeButton_Click"
                                AutomationProperties.Name="最大化" ToolTip="最大化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="9" />
                        </Button>
                        <Button Style="{StaticResource CloseWindowButtonStyle}" Click="CloseButton_Click"
                                AutomationProperties.Name="关闭" ToolTip="关闭"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="9" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" x:Name="PageHost" ClipToBounds="True">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PageTranslate" />
                    </Grid.RenderTransform>

                    <views:HomeView x:Name="HomePageView"
                                    Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVisibility}}" />
                    <views:DownloadsView x:Name="DownloadsPageView"
                                         Visibility="{Binding IsDownloadsPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:SettingsView x:Name="SettingsPageView"
                                        Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:AboutView x:Name="AboutPageView"
                                     Visibility="{Binding IsAboutPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:MoreView x:Name="MorePageView"
                                    Visibility="{Binding IsMorePage, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border Grid.Row="2" Background="#40FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="20,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="9.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveDownloadSummary}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="ToastBorder" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,22,42" Padding="13,9" CornerRadius="10"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="200">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#E632292F" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#3A2230" BlurRadius="16" ShadowDepth="4" Opacity="0.2" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="Background" Value="#E6C3455B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ToastMessage}" FontSize="11" Foreground="White"
                           MaxWidth="340" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
</Window>
